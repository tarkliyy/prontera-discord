[Unit]
Description=บอทข่าวเศรษฐกิจ ทองไทย ข่าวด่วน
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=kao
WorkingDirectory=/opt/kao
ExecStart=/usr/bin/node kao.mjs
TimeoutStartSec=58min
Environment=TZ=Asia/Bangkok
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/opt/kao
